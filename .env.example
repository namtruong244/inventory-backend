# Server Configuration
PORT=8080
APP_ENV=development
BASE_URL=http://localhost:8080

# Database Configuration (PostgreSQL)
# For AWS Lambda, point to AWS RDS PostgreSQL, Supabase, Neon, or Railway
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inventory_db
DB_SSLMODE=disable

# Database Connection Pool (Defaults optimal for Lambda and local servers)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
RUN_MIGRATIONS=true

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_1234567890
JWT_EXPIRATION_HOURS=720

# Storage Configuration
# Choose "local" for local disk storage or "r2" for Cloudflare R2
STORAGE_DRIVER=local

# Local File Uploads (Used when STORAGE_DRIVER=local)
UPLOAD_DIR=./uploads

# Cloudflare R2 Object Storage (Used when STORAGE_DRIVER=r2)
# Account ID from Cloudflare Dashboard URL or Overview
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API Token credentials (Permissions: Object Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2 Bucket Name
R2_BUCKET_NAME=inventory-media
# Public access URL (either custom domain e.g. https://media.yourdomain.com or R2.dev public URL e.g. https://pub-xxx.r2.dev)
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
